/**
  * @brief  This function is executed in case of error occurrence.
  * @retval None
  */
void Error_Handler(void)
{
  /* USER CODE BEGIN Error_Handler_Debug */

  __disable_irq();

  /*
   * Turn OFF status LED
   * Turn ON fault LED
   */
  HAL_GPIO_WritePin(
      GPIOB,
      BMS_STATUS_LED_Pin,
      GPIO_PIN_RESET
  );

  HAL_GPIO_WritePin(
      GPIOB,
      BMS_FAULT_LED_Pin,
      GPIO_PIN_SET
  );

  while (1)
  {
  }

  /* USER CODE END Error_Handler_Debug */
}

