/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_ADC1_Init();
  MX_CAN_Init();
  MX_I2C1_Init();
  MX_USART1_UART_Init();

  /* USER CODE BEGIN 2 */

  /*
   * Start the BMS CAN subsystem.
   *
   * The actual CAN initialization is generated by CubeMX
   * in MX_CAN_Init().
   *
   * BMS_CAN_Start() starts the CAN peripheral.
   */
  BMS_CAN_Start();
  BMS_ADC_Init();
  BMS_SOC_Init();
  BMS_SOH_Init();
  BMS_Temperature_Init();
  /* Simulated BMS values */
  BMS_Data.battery_voltage = 48.5f;
  BMS_Data.battery_current = 12.3f;
  BMS_Data.battery_temperature = 32.0f;

  BMS_Data.state_of_charge = 85.0f;
  BMS_Data.state_of_health = 98.0f;

  BMS_Data.voltage_min = 3.0f;
  BMS_Data.voltage_max = 4.2f;

  BMS_Data.temperature_min = 0.0f;
  BMS_Data.temperature_max = 45.0f;

  BMS_Data.over_voltage = 0;
  BMS_Data.under_voltage = 0;
  BMS_Data.over_current = 0;
  BMS_Data.over_temperature = 0;

  /* BMS status LED ON */
  HAL_GPIO_WritePin(
      GPIOB,
      BMS_STATUS_LED_Pin,
      GPIO_PIN_SET
  );

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */

  while (1)
  {
	  /* Read ADC measurements */
	  BMS_ADC_Update();

	  /* Update battery temperature */
	  	  BMS_Temperature_Update();

	  /* Update State of Charge */
	  BMS_SOC_Update();

	  /* Update State of Health */
	  BMS_SOH_Update();

	  /* Check BMS safety conditions */
	 	  BMS_Faults_Update();


	  /* Update BMS status LED */
	  if (BMS_Data.over_voltage ||
	      BMS_Data.under_voltage ||
	      BMS_Data.over_current ||
	      BMS_Data.over_temperature)
	  {
	      HAL_GPIO_WritePin(
	          GPIOB,
	          BMS_STATUS_LED_Pin,
	          GPIO_PIN_RESET
	      );
	  }
	  else
	  {
	      HAL_GPIO_WritePin(
	          GPIOB,
	          BMS_STATUS_LED_Pin,
	          GPIO_PIN_SET
	      );
	  }

	  /* Update fault LED */
	  if (BMS_Data.over_voltage ||
	      BMS_Data.under_voltage ||
	      BMS_Data.over_current ||
	      BMS_Data.over_temperature)
	  {
	      HAL_GPIO_WritePin(
	          GPIOB,
	          BMS_FAULT_LED_Pin,
	          GPIO_PIN_SET
	      );
	  }
	  else
	  {
	      HAL_GPIO_WritePin(
	          GPIOB,
	          BMS_FAULT_LED_Pin,
	          GPIO_PIN_RESET
	      );
	  }

	  /* Send updated BMS data over CAN */
	  BMS_CAN_SendTestMessage();

	  HAL_Delay(1000);

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */

  }

  /* USER CODE END 3 */
}

