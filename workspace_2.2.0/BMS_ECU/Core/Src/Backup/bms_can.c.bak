#include "bms_can.h"
#include "bms_data.h"

extern CAN_HandleTypeDef hcan;

void BMS_CAN_Start(void)
{
    if (HAL_CAN_Start(&hcan) != HAL_OK)
    {
        Error_Handler();
    }
}

void BMS_CAN_SendTestMessage(void)
{
    CAN_TxHeaderTypeDef TxHeader;
    uint8_t TxData[8];
    uint32_t TxMailbox;

    /*
     * CAN ID 0x100
     *
     * Byte 0-1 : Battery voltage (0.1 V)
     * Byte 2-3 : Battery current (0.1 A)
     * Byte 4   : SOC (%)
     * Byte 5   : Temperature (°C)
     * Byte 6   : SOH (%)
     * Byte 7   : Fault flags
     */

    uint16_t voltage =
        (uint16_t)(BMS_Data.battery_voltage * 10.0f);

    uint16_t current =
        (uint16_t)(BMS_Data.battery_current * 10.0f);

    uint8_t soc =
        (uint8_t)(BMS_Data.state_of_charge);

    uint8_t temperature =
        (uint8_t)(BMS_Data.battery_temperature);

    uint8_t soh =
        (uint8_t)(BMS_Data.state_of_health);

    uint8_t fault_flags = BMS_Data.fault_status;

    /* Pack data into CAN frame */

    TxData[0] = (uint8_t)(voltage >> 8);
    TxData[1] = (uint8_t)(voltage & 0xFF);

    TxData[2] = (uint8_t)(current >> 8);
    TxData[3] = (uint8_t)(current & 0xFF);

    TxData[4] = soc;
    TxData[5] = temperature;
    TxData[6] = soh;
    TxData[7] = fault_flags;

    /* Configure CAN frame */

    TxHeader.StdId = 0x100;
    TxHeader.ExtId = 0x00;
    TxHeader.RTR = CAN_RTR_DATA;
    TxHeader.IDE = CAN_ID_STD;
    TxHeader.DLC = 8;
    TxHeader.TransmitGlobalTime = DISABLE;

    /* Transmit CAN frame */

    if (HAL_CAN_AddTxMessage(&hcan,
                             &TxHeader,
                             TxData,
                             &TxMailbox) != HAL_OK)
    {
        Error_Handler();
    }
}
